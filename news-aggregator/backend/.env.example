# Copy this file to .env and adjust as needed. Every value here is optional —
# the app runs with sensible defaults (SQLite, RSS-only, no translation key
# required) if you never create a .env at all.

# --- Database -----------------------------------------------------------
# DATABASE_URL=sqlite:////app/data/news.db

# --- Ingestion ------------------------------------------------------------
# POLL_INTERVAL_MINUTES=15
# HTTP_TIMEOUT_SECONDS=15
# FETCH_CONCURRENCY=8

# --- Dedup (see app/processing/dedup.py for how these are used) -----------
# DEDUP_TITLE_SIMILARITY_THRESHOLD=85
# DEDUP_COMBINED_SIMILARITY_THRESHOLD=58
# DEDUP_WINDOW_HOURS=72

# --- Summarization ----------------------------------------------------
# SUMMARY_MAX_WORDS=40
# Optional pluggable LLM summarizer (falls back to extractive if unset/fails)
# LLM_SUMMARIZER_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Translation (pluggable; UI degrades gracefully if unavailable) -----
# "none" | "google_free" (default, no key needed) | "libretranslate"
# TRANSLATION_PROVIDER=google_free
# LIBRETRANSLATE_URL=https://libretranslate.com/translate
# LIBRETRANSLATE_API_KEY=

# --- Optional free-tier news APIs (all optional; RSS works without them) ---
# GNews: https://gnews.io (free tier, no card required)
# GNEWS_API_KEY=
# NewsData.io: https://newsdata.io (free tier, no card required)
# NEWSDATA_API_KEY=
# Currents: https://currentsapi.services (free tier, no card required)
# CURRENTS_API_KEY=
